# yocr systemd unit —— 由 Makefile 的 systemd-install 目标渲染部署，
# 占位符: __APP_DIR__ __RUN_USER__ __RUN_GROUP__ __HOST__ __PORT__ __DEVICE__
#         __OCR_LANG__ __HF_HOME__ __PADDLE_CACHE__ __HF_OFFLINE__ __PRELOAD_MODELS__
#         __HF_ENDPOINT__ __SUCAI_DIR__
[Unit]
Description=yocr - YOLO+PaddleOCR vision analysis service
Documentation=https://github.com/TenMilesSwordGod/yocr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/yocr serve --host __HOST__ --port __PORT__
Environment=YOCR_DEVICE=__DEVICE__
Environment=YOCR_OCR_LANG=__OCR_LANG__
Environment=HF_HOME=__HF_HOME__
Environment=PADDLE_PDX_CACHE_HOME=__PADDLE_CACHE__
# 模型已由 make models-download 预下载；置 0 可恢复联网按需下载
Environment=HF_HUB_OFFLINE=__HF_OFFLINE__
# 启动即预加载模型（缺权重的模型会记录 error 并继续，不阻塞服务）
Environment=YOCR_PRELOAD_MODELS=__PRELOAD_MODELS__
Environment=HF_ENDPOINT=__HF_ENDPOINT__
Environment=HF_HUB_DISABLE_XET=1
# 素材库(前端"素材注册/查找定位"功能)持久化目录
Environment=YOCR_SUCAI_DIR=__SUCAI_DIR__
# 可选: 在 /etc/yocr/yocr.env 里放额外环境变量(每行 KEY=VALUE)，优先级高于上面的值
EnvironmentFile=-/etc/yocr/yocr.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# 轻量加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
